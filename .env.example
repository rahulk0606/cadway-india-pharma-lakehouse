# AWS Credentials & S3 Storage
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=ap-south-1
STORAGE_BASE_PATH=s3a://cadway-india-pharma-lakehouse-prod

# MySQL Serving Warehouse
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cadway_india_dw
MYSQL_USER=cadway_etl_user
MYSQL_PASSWORD=your_strong_password_here

# Security & Data Quality Thresholds
HIPAA_ABHA_SALT=replace_with_32_byte_random_hex_salt
MAX_QUARANTINE_THRESHOLD_PCT=5.0
